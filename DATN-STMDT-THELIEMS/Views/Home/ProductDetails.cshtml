@model DATN_STMDT_THELIEMS.Models.Products

@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        /* Chỉnh phông chữ và kích thước chữ */
        body {
            font-family: 'Arial', sans-serif;
        }

        h1, h4 {
            font-weight: 700;
            font-size: 24px;
        }

        p {
            font-size: 14px;
        }
        .breadcrumb-item a {
            font-size: 1rem;
            color: #6c757d !important;
        }

        .breadcrumb {
            background: none;
        }

        .product-title {
            font-size: 2.2rem;
            font-weight: bold;
            color: #333;
        }

        .price {
            font-size: 24px;
            font-weight: bold;
            color: #e60000;
        }

        .original-price {
            font-size: 1rem;
            text-decoration: line-through;
            color: #6c757d;
        }

        .badge {
            font-size: 1rem;
        }

        .shop-title {
            font-size: 1.5rem;
            font-weight: bold;
        }

       .card-img-top {
        width: 200px;
        height: 250px; 
        object-fit: cover; /* Cắt ảnh để vừa khung */
        margin: 0 auto; /* Căn giữa ảnh nếu chiều ngang cố định nhỏ hơn chiều ngang thẻ chứa */
        }

        .similar-product-name {
            font-size: 16px;
            color: #333;
            margin-bottom: 5px;
        }

        .similar-product-price {
            font-size: 18px;
            color: #ff4500;
        }


        /* Điều chỉnh kích thước của cả 2 nút "Mua Ngay" và "Thêm Vào Giỏ" */
        .btn-buy {
            font-size: 18px;
            padding: 15px 30px; 
            width: 200px;
        }

        /* Ẩn spinner (nút tăng/giảm số) trên trình duyệt Chrome, Safari, Edge, Opera */
        input[type=number]::-webkit-inner-spin-button, 
        input[type=number]::-webkit-outer-spin-button { 
            -webkit-appearance: none; 
            margin: 0; 
        }

        /* Ẩn spinner trên Firefox */
        input[type=number] {
            -moz-appearance: textfield;
        }

        .rating-summary {
            font-size: 48px;
            color: #ff4500;
            line-height: 1;
            margin-bottom: 0;
        }

        .rating-stars {
            font-size: 32px;
            margin-top: 5px;
        }

        .rating-center {
            display: inline-block;
            text-align: center;
        }

        .rating-breakdown .progress {
            margin-bottom: 10px;
            width: 100%; /* Ensure all progress bars are the same length */
        }

        .rating-breakdown span,
        .rating-breakdown .progress-bar {
            font-size: 16px;
        }

        .rating-filters .btn {
            margin-right: 10px;
            padding: 8px 15px;
            font-size: 14px;
        }

        .rating-breakdown .d-flex span:first-child {
            white-space: nowrap; /* Prevent "sao" from breaking into a new line */
        }

        .star {
            font-size: 20px;
            color: #ffcc00;
        }

        .progress {
            height: 16px;
        }

        .review-card {
            border: 1px solid #f1f1f1;
            border-radius: 10px;
            margin-bottom: 15px;
            padding: 20px;
        }

        .review-card .review-header {
            display: flex;
            align-items: center;
        }

        .review-card .review-header img {
            border-radius: 50%;
            width: 50px;
            height: 50px;
            margin-right: 15px;
        }

        .review-card .review-content p {
            margin-bottom: 10px;
        }

        .review-card .review-images img {
            margin-right: 10px;
        }

        .seller-response {
            background-color: #f9f9f9;
            padding: 10px;
            border-left: 5px solid #28a745;
            margin-top: 15px;
        }

        .btn-like {
            margin-top: 10px;
            padding: 5px 10px;
        }

        .category-menu {
            padding: 20px;
            background-color: #fff; 
            border-radius: 10px;
            margin-bottom: 20px;
            text-align: center;
            border: 2px solid #dee2e6; /* Thêm khung */
        }
        .category-item {
            width: 23%;
            display: inline-block;
            margin: 0 10px;
            transition: all 0.3s ease; 
        }
        .category-item img {
            max-width: 60px;
            margin-bottom: 10px;
        }
        .category-item p {
            font-size: 1.1rem;
            font-weight: bold;
            margin: 0;
        }
        .category-item a {
            text-decoration: none;
            color: inherit;
        }
        /* Hover effect */
        .category-item:hover p {
            color: #007bff;
            text-decoration: underline; 
        }
        .product-card {
            padding: 15px;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
            height: 100%;
        }
        .product-card img {
            max-width: 100%;
            border-radius: 10px;
        }
        .product-card .product-price {
            color: red;
            font-weight: bold;
        }
        .product-card .old-price {
            text-decoration: line-through;
            color: grey;
        }

        h2 {
            font-size: 2rem;
            text-align: center;
            font-weight: bold;
            margin-bottom: 20px;
        }

        /* Giữ nguyên thumbnail-container và main-image */
        .thumbnail-container {
            width: 435px; /* Đảm bảo chỉ hiển thị 5 ảnh */
            overflow: hidden; /* Ẩn các ảnh không nằm trong vùng hiển thị */
        }

        .main-image {
            width: 90%;
            max-width: 500px; 
            height: 500px; 
            object-fit: cover; 
            margin: 0 auto; /* Căn giữa ảnh */
            position: relative;
            z-index: 1; 
        }

        .thumbnail {
            cursor: pointer;
            transition: all 0.3s ease; /* Hiệu ứng chuyển động khi hover */
        }

        .thumbnail:hover {
            opacity: 0.8; /* Giảm độ sáng khi hover để tạo hiệu ứng */
            border: 2px solid #007bff; /* Thêm đường viền màu xanh khi hover */
        }

        #thumbnail-wrapper {
            transition: transform 0.3s ease; /* Tạo hiệu ứng khi cuộn thumbnail */
        }

        /* Hiệu ứng cho ảnh phụ đang được hiển thị */
        .active-thumbnail {
            border: 2px solid #007bff; /* Viền màu xanh để nổi bật ảnh phụ */
            opacity: 1; /* Đảm bảo ảnh hiện đủ sáng */
            transform: scale(1.05); /* Tăng kích thước một chút để nổi bật */
            transition: all 0.3s ease; /* Tạo hiệu ứng mượt */
        }

        /* Điều chỉnh vị trí các nút điều hướng */
        .thumbnail-control {
            width: 40px;
            height: 40px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: rgba(0, 0, 0, 0.5); /* Màu nền mờ */
            border-radius: 50%; /* Bo tròn nút */
            z-index: 10;
            opacity: 1;
            pointer-events: auto;
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
        }

        /* Vị trí nút trái ngoài mép bìa của ảnh chính */
        .carousel-control-prev {
            left: 10px; 
        }

        .carousel-control-next {
            right: 10px; 
        }

        /* Nút điều hướng bị mờ khi không thể cuộn */
        .thumbnail-control.disabled {
            opacity: 0.3;
            pointer-events: none;
        }

        .custom-frame {
            max-width: 600px;
            margin: 0 auto; 
        }

        /* Style hover và active cho danh mục */
        .category-item {
            cursor: pointer; /* Con trỏ hình bàn tay khi hover */
            transition: transform 0.2s;
        }

        .category-item:hover {
            transform: scale(1.05);
        }

        .category-item.active-category a {
            color: #28a745;
            font-weight: bold;
            text-decoration: underline;
        }

        /* Style hover cho sản phẩm */
        .card {
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card:hover {
            transform: scale(1.05); /* Phóng to nhẹ */
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang Chủ</a></li>
                <li class="breadcrumb-item"><a href="#">Áo Sơ Mi</a></li>
                <li class="breadcrumb-item active" aria-current="page">Áo Sơ Mi Nam Thiết Kế Nam Tính</li>
            </ol>
        </nav>

        <!-- Product Main Section -->
        <div class="row">
            <div class="col-md-6">
                <div class="position-relative d-flex justify-content-center">
                    <!-- Nút cuộn trái kiểu Bootstrap -->
                    <button id="prev-btn" class="carousel-control-prev thumbnail-control" type="button" onclick="scrollThumbnails(-1)">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>

                    <!-- Ảnh chính -->
                    <img id="main-image" src="@Model.Image" alt="Áo Sơ Mi Nam" class="img-fluid border mb-2 main-image">

                    <!-- Nút cuộn phải kiểu Bootstrap -->
                    <button id="next-btn" class="carousel-control-next thumbnail-control" type="button" onclick="scrollThumbnails(1)">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>

                <!-- Thanh cuộn ảnh thumbnail với nút điều hướng Bootstrap -->
                <div class="d-flex justify-content-center align-items-center position-relative mt-3">
                    <!-- Các ảnh thumbnail được đặt trong một khung cuộn -->
                    <div class="thumbnail-container mx-2 overflow-hidden">
                        <div class="d-flex" id="thumbnail-wrapper">
                            @foreach (var product in Model.Product_Variants)
                            {
                                @foreach (var value in product.Product_Variant_Options)
                                {
                                    if (value.variant_values.Variant_Options.Name == "Màu")
                                    {
                                        <img src="@value.product_Variants.Image" alt="Thumbnail 2" class="img-thumbnail me-2 thumbnail" width="80" height="80" onclick="changeImage(this)">
                                    }
                                }
                            }                 
                        </div>
                    </div>
                </div>

                <br>
                <!-- Banner quảng cáo -->          
                <div id="brandCarousel" class="carousel slide" data-bs-ride="carousel">
                    <!-- Indicators -->
                   <div class="carousel-indicators">
                      <button type="button" data-bs-target="#brandCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
                      <button type="button" data-bs-target="#brandCarousel" data-bs-slide-to="1"></button>
                      <button type="button" data-bs-target="#brandCarousel" data-bs-slide-to="2"></button>
                    </div>

                    <!-- Carousel items -->
                    <div class="carousel-inner">
                      <div class="carousel-item active">
                        <div class="text-center">
                            <div class="p-3 border border-success rounded custom-frame">
                              <img src="/images/imgqc.webp" class="d-block w-100" alt="Brand 1">
                            </div>
                        </div>
                      </div>
                      <div class="carousel-item">
                        <div class="text-center">
                            <div class="p-3 border border-success rounded custom-frame">
                              <img src="/images/imgqc2.png" class="d-block w-100" alt="Brand 2">
                            </div>
                        </div>
                      </div>
                      <div class="carousel-item">
                        <div class="text-center">
                            <div class="p-3 border border-success rounded custom-frame">
                              <img src="/images/imgqc1.jpg" class="d-block w-100" alt="Brand 3">
                            </div>
                        </div>
                      </div>
                    </div>

                    <!-- Carousel controls -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#brandCarousel" data-bs-slide="prev">
                      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#brandCarousel" data-bs-slide="next">
                      <span class="carousel-control-next-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>

            <!-- Product Information Section -->
            <div class="col-md-6">
                <h1 class="product-title">@Model.Name</h1>
                <p class="text-muted fs-6 fw-bold">Thương hiệu: <span class="text-primary">@Model.Brands.Name</span></p>
                <div class="d-flex align-items-center mb-2">
                    <span class="me-2">⭐⭐⭐⭐⭐</span>
                    <span>(205 đánh giá) | Đã bán: @Model.Sold_count</span>
                </div>
                <div class="mb-3">
                    <span class="price">@Model.DiscountedPrice?.ToString("N0")₫</span>
                    <span class="original-price ms-2">@Model.Price.GetValueOrDefault().ToString("N0")₫</span>
                    <span class="badge bg-danger ms-2">-@Model.Percent_Decrease%</span>
                </div>
                <!-- Color Options -->
                <div class="mb-3">
                <p><strong class="fs-6">Màu sắc:</strong></p>
                <div class="d-inline-flex flex-wrap">
                            @foreach (var product in Model.Product_Variants)
                            {
                                @foreach (var value in product.Product_Variant_Options)
                                {
                                    if (value.variant_values.Variant_Options.Name == "Màu")
                                    {
                                        <button class="btn btn-outline-secondary btn-sm me-2 d-flex align-items-center fs-6 mb-2" style="width: 160px; height: 60px;" onclick="changeColor('@value.product_Variants.Image')">
                                            <img src="@value.product_Variants.Image" alt="Màu Trắng" class="rounded-circle me-2" width="50" height="50">
                                            @value.variant_values.Name
                    </button>
                                    }
                                }
                            }                 
                </div>
            </div>


                <!-- Size Options -->
                <div class="mb-3">
                 <p><strong class="fs-6">Size:</strong></p>
                <div class="d-flex">
                    @foreach (var product in Model.Product_Variants)
                    {
                        @foreach (var value in product.Product_Variant_Options)
                        {
                            if (value.variant_values.Variant_Options.Name == "Kích thước")
                            {
                                <button class="btn btn-outline-secondary btn-sm me-3" style="min-width: 45px;">@value.variant_values.Name</button>
                            }
                        }
                    }       
                </div>
                <div class="mt-2">
                    <a href="#" class="text-primary">Bảng Quy Đổi Kích Thước</a>
                </div>
                
                </div>

                <hr class="my-4">
                <!-- Shipping Information -->
                <div class="mb-3">
                    <p><strong class="fs-6">Thông Tin Vận Chuyển:</strong></p>
                    <p class="fs-6">Giao đến: ấp Vĩnh Bình, xã Vĩnh Lộc, huyện Hồng Dân, Bạc Liêu - <a href="#">Đổi địa chỉ</a></p                 
                </div>
                <div class="mb-3">
                    <hr class="my-4">
                    <div class="d-flex align-items-center">
                        <img src="/images/iconship.png" alt="icon" class="img-fluid" style="width: 60px; height: 40px;" />
                        <span class="ms-2">Giao Thứ Năm</span>
                    </div>
                    <p class="fs-6">Trước 19h, ngày 28/10/2024 - Phí vận chuyển:
                        <span class="fw-semibold fs-6">18.500</span>
                        <span class="original-price ms-1 fs-7">39.000₫</span>
                    </p>
                </div>
                <div class="mb-3">
                    <div class="d-flex align-items-center">
                        <img src="/images/iconfreeship.png" alt="icon" class="img-fluid" style="width: 20px; height: 20px;" />
                        <span class="text-danger fw-bold ms-2">Freeship 10k đơn từ 45k, Freeship 25k đơn từ 100k</span>
                    </div>
                </div>

                <hr class="my-4">

                <!-- Quantity and Subtotal -->
                <div class="mb-3">
                    <p><strong class="fs-6">Số lượng:</strong></p>    
                    <div class="input-group mb-3" style="width: 180px;">
                        <!-- Button Giảm -->
                        <button class="btn btn-outline-primary rounded-start px-3 decrease-btn" type="button">-</button>
                        <!-- Input Số lượng -->
                        <input id="quantityInput" type="number" class="form-control text-center border-primary" value="1" min="1" max="20" style="height: 38px; padding: 0; width: 50px;">
                        <!-- Button Tăng -->
                        <button class="btn btn-outline-primary rounded-end px-3 increase-btn" type="button">+</button>
                    </div>
                    <p id="quantityAlert" class="text-danger" style="display: none; font-size: 14px;">Chỉ được chọn tối đa số lượng là 20</p>
                    <p><strong class="fs-6">Tạm tính: <span id="subtotal" class="price">@Model.DiscountedPrice.GetValueOrDefault().ToString("N0")₫</span></strong></p>
                </div>

                <!-- Buy and Cart Buttons -->
                <div>
                    <button class="btn btn-danger btn-buy me-2">Mua Ngay</button>
                    <button class="btn btn-outline-secondary btn-buy">Thêm vào giỏ</button>
                </div>  
            </div>
        </div>

        <!-- Divider -->
        <hr class="my-4">

        <!-- Shop Information -->
        <div class="d-flex align-items-center mb-4">
            <img src="/images/logoowen.webp" alt="Shop Logo" width="80" height="80" class="me-3">
            <div>
                <h5 class="shop-title mb-0">Thời Trang Nam Owen</h5>
                <p class="text-muted fs-6">Online 20 Phút Trước | Đánh giá: 2.8k | Tỉ lệ phản hồi: 95%</p>
                <button class="btn btn-outline-primary btn-sm me-2">Theo Dõi</button>
                <button class="btn btn-outline-secondary btn-sm">Xem Shop</button>
            </div>
        </div>

        <hr class="my-4">

        <div class="container mt-4">
        <h4 class="mb-4">CHI TIẾT SẢN PHẨM</h4>
        <div class="row">
            <div class="col-md-6">
                <ul class="list-group">
                    <li class="list-group-item"><strong>Danh Mục:</strong> Shopee &gt; Thời Trang Nam &gt; Áo sơ mi</li>
                    <li class="list-group-item"><strong>Kho:</strong> 237232</li>
                    <li class="list-group-item"><strong>Kiểu dáng quần:</strong> Slim Fit</li>
                    <li class="list-group-item"><strong>Mùa:</strong> Mùa xuân</li>
                    <li class="list-group-item"><strong>Xuất xứ:</strong> Việt Nam</li>
                    <li class="list-group-item"><strong>Chất liệu:</strong> Lụa</li>
                    <li class="list-group-item"><strong>Phong cách:</strong> Tinh tế, sang trọng</li>
                    <li class="list-group-item"><strong>Loại trang phục:</strong> Công sở, đi chơi</li>
                    <li class="list-group-item"><strong>Mẫu:</strong> In</li>
                </ul>
            </div>
            <div class="col-md-6">
                <ul class="list-group">
                    <li class="list-group-item"><strong>Chiều dài áo:</strong> Dài</li>
                    <li class="list-group-item"><strong>Rất lớn:</strong> Có</li>
                    <li class="list-group-item"><strong>Cổ áo:</strong> Cổ chữ V</li>
                    <li class="list-group-item"><strong>Chiều dài tay áo:</strong> Tay dài</li>
                    <li class="list-group-item"><strong>Kiểu nút:</strong> Túi</li>
                    <li class="list-group-item"><strong>Tên tổ chức chịu trách nhiệm sản xuất:</strong> SHOP TheLiems</li>
                    <li class="list-group-item"><strong>Địa chỉ tổ chức chịu trách nhiệm sản xuất:</strong> SHOP TheLiems</li>
                    <li class="list-group-item"><strong>Gửi từ:</strong> TP. Cần Thơ</li>
                </ul>
            </div>
            </div>
        </div>  

        <hr class="my-4">

        <!-- Product Description Section -->
        <div class="product-description mt-4">
            <h4>MÔ TẢ SẢN PHẨM</h4>
            <p class="fs-6"><strong>Chất liệu:</strong> 48% Bamboo, 48% Polyester, 4% Spandex</p>
            <p class="fs-6"><strong>Kiểu dáng:</strong> Bodyfit</p>
            <p class="fs-6"><strong>Xuất xứ:</strong> Việt Nam</p>
            <h5 class="fs-6"><strong>Thông tin thương hiệu:</strong></h5>
            <p class="fs-6">Owen là thương hiệu thời trang công sở cao cấp được phân phối bởi công ty thời trang Kowil thuộc tập đoàn Phú Thái - tập đoàn phân phối thời trang lớn tại Việt Nam.</p>
            <p class="fs-6">Các sản phẩm của Owen có kiểu dáng hiện đại được may từ chất liệu vải cao cấp, mang lại phong cách tươi trẻ nhưng không kém phần năng động, cá tính.</p>
            <h5 class="fs-6"><strong>Lưu ý:</strong></h5>
            <p class="fs-6">+ KIỂU DÁNG SLIMFIT SẼ ÔM VÀ NHỎ HƠN REGULARFIT 1 SIZE.</p>
            <p class="fs-6">+ KIỂU DÁNG TRENDY SẼ ÔM VÀ NHỎ HƠN SLIMFIT 1 SIZE.</p>
        </div>

        <hr class="my-4">



        <div class="container my-5">
          <!-- Rating Section -->
          <div class="card p-4">
            <div class="row">
              <!-- Left Section -->
              <div class="col-md-4 text-center">
                <h4 class="text-center fs-3">Khách Hàng Đánh Giá</h4>
                <div class="rating-center mt-2">
                  <h2 class="rating-summary ">4.9</h2>
                  <div class="rating-stars text-warning">★★★★★</div>
                </div>
              </div>

              <!-- Right Section (Rating Breakdown) -->
              <div class="col-md-8">
                <div class="rating-breakdown">

                  <div class="d-flex align-items-center mb-2">
                    <span class="me-2">5 sao</span>
