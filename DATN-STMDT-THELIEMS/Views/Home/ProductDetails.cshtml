        const thumbnailWrapper = document.getElementById('thumbnail-wrapper');

        // Hàm để cuộn các thumbnail và hiển thị ảnh chính
        function scrollThumbnails(direction) 
        {
            const totalThumbnails = thumbnails.length;
            const maxScrollPosition = totalThumbnails - maxVisibleThumbnails;

            // Cập nhật vị trí hiện tại dựa trên hướng cuộn
            currentPosition += direction;

            // Nếu vị trí cuộn vượt quá maxScrollPosition, chỉ thay đổi ảnh chính chứ không cuộn thêm
            if (currentPosition > maxScrollPosition)
            {
                currentPosition = Math.min(currentPosition, totalThumbnails - 1);
            }

            // Cập nhật ảnh chính dù cuộn hay không cuộn
            changeImageByIndex(currentPosition);

            // Chỉ cuộn nếu chưa vượt quá maxScrollPosition
            if (currentPosition <= maxScrollPosition) 
            {
                const scrollAmount = currentPosition * (thumbnails[0].offsetWidth + 8); // Kích thước + khoảng cách giữa các thumbnail
                thumbnailWrapper.style.transform = `translateX(-${scrollAmount}px)`;
            }

            // Kiểm tra trạng thái của các nút điều hướng
            checkButtonStatus();
        }

        // Hàm thay đổi ảnh chính và cập nhật thumbnail
        function changeImageByIndex(index) {
            const mainImage = document.getElementById('main-image');
    
            // Thay đổi ảnh chính
            mainImage.src = thumbnails[index].src;

            // Bỏ hiệu ứng nổi bật khỏi tất cả các ảnh phụ
            thumbnails.forEach(thumb => thumb.classList.remove('active-thumbnail'));

            // Thêm hiệu ứng nổi bật cho thumbnail tương ứng
            thumbnails[index].classList.add('active-thumbnail');
        }

        // Hàm để thay đổi ảnh chính khi click vào thumbnail
        function changeImage(thumbnail) {
            const index = Array.from(thumbnails).indexOf(thumbnail);
            currentPosition = index;
            changeImageByIndex(index);
        }

        // Hàm để thay đổi ảnh chính khi đổi màu sắc
        function changeColor(imageSrc) {
            document.getElementById('main-image').src = imageSrc;
        }

        // Hàm để kiểm tra và thay đổi trạng thái của nút điều hướng
        function checkButtonStatus() {
            const prevBtn = document.getElementById('prev-btn');
            const nextBtn = document.getElementById('next-btn');
            const totalThumbnails = thumbnails.length;
            const maxScrollPosition = totalThumbnails - maxVisibleThumbnails;

            // Kiểm tra nút "Previous"
            if (currentPosition === 0)
            {
                prevBtn.classList.add('disabled');
            } 
            else 
            {
                prevBtn.classList.remove('disabled');
            }

            // Kiểm tra nút "Next"
            if (currentPosition >= totalThumbnails - 1) {
                nextBtn.classList.add('disabled');
            } 
            else 
            {
                nextBtn.classList.remove('disabled');
            }
        }

        // Khởi tạo trạng thái của nút điều hướng và ảnh chính khi trang được load
        document.addEventListener('DOMContentLoaded', () => {
            checkButtonStatus();
            changeImageByIndex(currentPosition); 
        });

        // Phần khám phá thêm
        function showCategory(categoryId, element) {
            // Ẩn tất cả các khối sản phẩm
            const categories = document.querySelectorAll('.product-category');
            categories.forEach(category => {
              category.classList.add('d-none');
            });

            // Hiển thị danh mục được chọn
            const selectedCategory = document.getElementById(categoryId);
            selectedCategory.classList.remove('d-none');

            // Loại bỏ lớp active từ tất cả danh mục
            const categoryItems = document.querySelectorAll('.category-item');
            categoryItems.forEach(item => {
              item.classList.remove('active-category');
            });

            // Thêm lớp active cho danh mục được chọn
            element.classList.add('active-category');
        }

        // Hiển thị danh mục mặc định
        document.addEventListener("DOMContentLoaded", function() {
            showCategory('danh-cho-ban', document.querySelector(".category-item"));
        });

        // Phần tăng giảm số lượng, giá tạm tính
        // Nút tăng giảm số lượng, tạm tính số tiền 
        const maxQuantity = 20;

        // Lấy giá sản phẩm đã giảm từ Razor và chuyển vào biến JavaScript
        const discountedPrice = parseFloat('@Model.DiscountedPrice.GetValueOrDefault()');

        // Lấy các thành phần cần thiết
        const quantityInput = document.getElementById('quantityInput');
        const subtotalElement = document.getElementById('subtotal');
        const decreaseButton = document.querySelector('.decrease-btn');
        const increaseButton = document.querySelector('.increase-btn');

        // Hàm tính toán tạm tính và cập nhật với định dạng dấu phẩy
        function updateSubtotal() {
            const quantity = parseInt(quantityInput.value);
            const subtotal = quantity * discountedPrice; // Dùng giá đã giảm
    
            // Định dạng số với dấu phẩy làm dấu phân cách phần nghìn
            const formattedSubtotal = subtotal.toLocaleString('vi-VN'); // Định dạng kiểu Việt Nam với dấu phẩy

            subtotalElement.textContent = formattedSubtotal + '₫'; // Hiển thị với dấu phẩy và đơn vị tiền tệ
        }

       // Sự kiện giảm số lượng
        decreaseButton.addEventListener('click', function () {
            let currentValue = parseInt(quantityInput.value);
            if (currentValue > 1) {
                quantityInput.value = currentValue - 1;
                quantityAlert.style.display = 'none'; // Ẩn thông báo nếu số lượng hợp lệ
                updateSubtotal();
            }
        });

        // Sự kiện tăng số lượng
        increaseButton.addEventListener('click', function () {
            let currentValue = parseInt(quantityInput.value);
            if (currentValue < maxQuantity) {
                quantityInput.value = currentValue + 1;
                quantityAlert.style.display = 'none'; // Ẩn thông báo nếu số lượng hợp lệ
                updateSubtotal();
            } else {
                // Hiển thị thông báo khi đạt đến số lượng tối đa
                quantityAlert.style.display = 'block';
            }
        });

        let selectedColor = '';
        let selectedSize = '';

        // Hàm để lưu màu sắc đã chọn và cập nhật hiển thị
        function selectColor(color) {
            selectedColor = color;

            // Xóa lớp active khỏi tất cả các tùy chọn màu
            document.querySelectorAll('.color-option').forEach(button => button.classList.remove('active-option'));

            // Thêm lớp active cho tùy chọn màu hiện tại
            event.currentTarget.classList.add('active-option');

            console.log("Color selected:", selectedColor);
        }

        // Hàm để lưu kích thước đã chọn và cập nhật hiển thị
        function selectSize(size) {
            selectedSize = size;

            // Xóa lớp active khỏi tất cả các tùy chọn kích thước
            document.querySelectorAll('.size-option').forEach(button => button.classList.remove('active-option'));

            // Thêm lớp active cho tùy chọn kích thước hiện tại
            event.currentTarget.classList.add('active-option');

            console.log("Size selected:", selectedSize);
        }



        // Hàm cập nhật tổng giá dựa trên số lượng
        function updateSubtotal() {
            const quantity = parseInt(quantityInput.value); // Lấy số lượng từ input
            const subtotal = quantity * discountedPrice; // Tính tổng giá
            document.getElementById('subtotal').textContent = subtotal.toLocaleString() + '₫'; // Hiển thị tổng giá
        }

        // Cập nhật tạm tính khi thay đổi thủ công số lượng
        quantityInput.addEventListener('input', function () {
            if (quantityInput.value < 1) {
                quantityInput.value = 1; // Giữ giá trị tối thiểu là 1
            }
            if (quantityInput.value > maxQuantity) {
                quantityInput.value = maxQuantity; // Giữ giá trị tối đa
                quantityAlert.style.display = 'block'; // Hiển thị thông báo
            } else {
                quantityAlert.style.display = 'none'; // Ẩn thông báo nếu số lượng hợp lệ
            }
            updateSubtotal(); // Cập nhật giá tạm tính
        });


        // Cập nhật giá tạm tính ban đầu
        updateSubtotal();
        
        // Chuyển trang và lấy số lượng sản phẩm 
        document.getElementById('buyNowButton').addEventListener('click', function (event) {
        event.preventDefault(); // Ngăn chặn việc mở liên kết ngay lập tức


        // Kiểm tra xem đã chọn màu sắc và kích thước hay chưa
        let alertMessage = ''; // Biến lưu trữ thông báo cần hiển thị

        // Kiểm tra màu sắc
        if (!selectedColor) {
            alertMessage += 'Vui lòng chọn màu sắc. ';
        }

        // Kiểm tra kích thước
        if (!selectedSize) {
            alertMessage += 'Vui lòng chọn kích thước. ';
        }

        // Nếu không chọn cả hai, hiển thị thông báo chung
        if (!selectedColor && !selectedSize) {
            alertMessage = 'Vui lòng chọn phân loại hàng.';
        }

        // Nếu có thông báo, hiển thị nó
        if (alertMessage) {
            document.getElementById('selectionAlert').style.display = 'block';
            document.getElementById('selectionAlert').textContent = alertMessage;
            return; // Dừng lại không thực hiện thao tác tiếp theo
        }


        // Lấy số lượng sản phẩm từ ô nhập
        const quantity = parseInt(quantityInput.value);
        const productId = @Model.Id;
        const subtotal = quantity * discountedPrice; 

        // Cập nhật liên kết chuyển đến trang thanh toán với số lượng đã chọn
        const payUrl = `@Url.Action("Pay", "Home")?productId=${productId}&quantity=${quantity}&price=${subtotal}&color=${encodeURIComponent(selectedColor)}&size=${encodeURIComponent(selectedSize)}`;

        // Điều hướng đến trang thanh toán với URL mới
        window.location.href = payUrl;

        window.addEventListener('pageshow', function (event) {
            if (event.persisted || performance.getEntriesByType("navigation")[0].type === "back_forward") {
                // Khi quay lại trang từ cache, reset số lượng về 1 và cập nhật lại giá tạm tính
                quantityInput.value = 1;
                updateSubtotal();
            }
        });
    });

    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>