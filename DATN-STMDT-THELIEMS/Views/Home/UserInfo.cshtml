<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thông tin tài khoản</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="userinfo.css">
</head>

<body>
    <div class="container mt-4">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3">
                <div class="d-flex flex-column align-items-center text-center">
                    <img src="../PC05852_NgoBaHieu_ASM2/picture/z5756286100324_d2d49e2a2a3a47bba4e7d044cf6ddb8c-Photoroom.png" alt="Avatar" class="rounded-circle" width="120">
                    <h4 class="mt-2">Ngô Bá Hiếu</h4>
                </div>
                <div class="list-group mt-4">
                    <a href="#" class="list-group-item list-group-item-action active">Thông tin tài khoản</a>
                    <a href="#" class="list-group-item list-group-item-action">Thông báo của tôi</a>
                    <a href="#" class="list-group-item list-group-item-action">Quản lý đơn hàng</a>
                    <a href="#" class="list-group-item list-group-item-action">Quản lý đổi trả</a>
                    <a href="#" class="list-group-item list-group-item-action">Số địa chỉ</a>
                    <a href="#" class="list-group-item list-group-item-action">Thông tin thanh toán</a>
                    <!-- Add other menu items here -->
                </div>
            </div>

            <!-- Main content -->
            <div class="col-md-9">
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Thông tin tài khoản</h5>
                        <form id="profileForm">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="fullname" class="form-label">Họ & Tên</label>
                                    <input type="text" class="form-control" id="fullname" value="Ngô Bá Hiếu">
                                </div>
                                <div class="col-md-6">
                                    <label for="nickname" class="form-label">Nickname</label>
                                    <input type="text" class="form-control" id="nickname" value="hennry_ngo">
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label for="dob-day" class="form-label">Ngày sinh</label>
                                    <select class="form-select" id="dob-day">
                                        <option selected>13</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="dob-month" class="form-label">Tháng</label>
                                    <select class="form-select" id="dob-month">
                                        <option selected>12</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="dob-year" class="form-label">Năm</label>
                                    <select class="form-select" id="dob-year">
                                        <option selected>2004</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="gender" class="form-label">Giới tính</label>
                                    <div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="gender" id="male" checked>
                                            <label class="form-check-label" for="male">Nam</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="gender" id="female">
                                            <label class="form-check-label" for="female">Nữ</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="gender" id="other">
                                            <label class="form-check-label" for="other">Khác</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label for="country" class="form-label">Quốc tịch</label>
                                    <select class="form-select" id="country">
                                        <option selected>Việt Nam</option>
                                    </select>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                        </form>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Số điện thoại và Email</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="phone" class="form-label">Số điện thoại</label>
                                <input type="text" class="form-control" id="phone" value="0835763407">
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label">Địa chỉ email</label>
                                <input type="email" class="form-control" id="email" placeholder="Thêm địa chỉ email">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Liên kết tài khoản</h5>
                        <div class="card p-3 d-flex mb-2">
                            <div class="d-flex align-items-center">
                                <span class="text-start">Facebook</span>
                                <button class="btn btn-primary text-end">Liên kết</button>
                            </div>
                        </div>
                        <div class="card p-3 d-flex mb-2">
                            <div class="d-flex align-items-center">
                                <span>Google</span>
                                <button class="btn btn-primary">Liên kế</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Bảo mật</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <button class="btn btn-outline-secondary w-100 mb-2">Đổi mật khẩu</button>
                            </div>
                            <div class="col-md-4">
                                <button class="btn btn-outline-secondary w-100 mb-2">Thiết lập mã PIN</button>
                            </div>
                            <div class="col-md-4">
                                <button class="btn btn-outline-danger w-100">Yêu cầu xóa tài khoản</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
