@{
    Layout = null;
}
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang Thanh Toán</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 1.1rem;
            background-color: #f5f5f5;
            color: #333;
        }

        /* Custom styles for navbar */
        .navbar {
            background-color: #f0fff4; /* Light green background */
            padding: 10px 20px;
        }

        .navbar-brand img {
            height: 100px; /* Adjust the logo size */
            margin-right: 8px;
        }

        .freeship-text {
            color: #28a745;
            font-weight: 500;
            text-align: center;
            font-size: 1.2rem;
        }

        .freeship-highlight {
            color: #007bff;
            font-weight: bold;
        }

        .contact-button {
            background-color: #f1f9ff;
            border: 1px solid #d1e7ff;
            color: #007bff;
            padding: 8px 15px;
            border-radius: 12px;
            font-weight: 500;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

            .contact-button i {
                font-size: 1.2rem;
                color: #007bff;
                margin-bottom: 5px;
            }

        .contact-number {
            font-size: 1.4rem;
            color: #007bff;
            font-weight: bold;
        }

        .contact-hours {
            font-size: 0.85rem;
            color: #6c757d;
            margin-top: -5px;
        }

        .container {
            max-width: 1200px;
            margin-top: 20px;
        }

        .card-header {
            font-weight: 600;
            font-size: 1.2rem;
            color: #333;
            background-color: #f8f8f8;
            padding: 12px 16px;
            border-bottom: 1px solid #e0e0e0;
        }

        .custom-checkbox {
            width: 1.4rem;
            height: 1.4rem;
        }

        .tick-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            background-color: #f9f9f9;
            margin-bottom: 15px;
        }

            .tick-box input[type="radio"] {
                width: 18px;
                height: 18px;
                margin-right: 10px;
                accent-color: #0084ff;
            }

        .badge {
            color: #fff;
            background-color: #ff4d4f;
            font-weight: 500;
            font-size: 0.95rem;
            padding: 4px 8px;
            border-radius: 12px;
        }

        .btn-buy {
            font-size: 18px; /* Kích thước chữ lớn hơn */
            padding: 15px 30px; /* Thêm khoảng trống để nút lớn hơn */
            width: 100%; /* Độ rộng của nút */
        }

        .product-item {
            display: flex;
            gap: 12px;
            margin-bottom: 15px;
            align-items: center;
        }

            .product-item img {
                width: 55px;
                height: 75px;
                object-fit: cover;
                border-radius: 4px;
                border: 1px solid #e0e0e0;
            }

        .text-muted {
            color: #6c757d;
            font-size: 1rem;
        }

        .text-danger {
            color: #ff4d4f;
            font-weight: 600;
        }

        .promo-item {
            display: flex;
            align-items: center;
            border: 1px solid #e0e0e0;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 10px;
        }

            .promo-item .remove-badge {
                color: #ff4d4f;
                font-weight: 500;
                font-size: 0.95rem;
                padding: 4px 8px;
                border-radius: 12px;
                border: 1px solid #ff4d4f;
                cursor: pointer;
            }

        .summary-item {
            display: flex;
            justify-content: space-between;
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .summary-item-discount {
            color: #ff4d4f;
        }

        .btn-primary-custom {
            background-color: #ff424e;
            border: none;
            font-weight: 500;
            padding: 12px 16px;
            font-size: 1.1rem;
            border-radius: 4px;
            width: 100%;
            transition: background-color 0.3s;
        }

            .btn-primary-custom:hover {
                background-color: #e63946;
            }

        .text-link {
            color: #007bff;
            cursor: pointer;
            font-size: 1.1rem;
        }

            .text-link:hover {
                text-decoration: underline;
            }

        .payment-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 20px;
            background-color: #f9f9f9;
        }

        .payment-card-header {
            font-size: 1.4rem;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .payment-option {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            position: relative;
        }

            .payment-option img {
                width: 40px;
                height: 40px;
            }

            .payment-option label {
                font-size: 1.1rem;
                display: flex;
                align-items: center;
                gap: 12px;
                cursor: pointer;
            }

                .payment-option label div {
                    display: flex;
                    flex-direction: column; /* Sắp xếp phần tên ví và mô tả theo cột */
                }

                .payment-option label small {
                    font-size: 1rem;
                    color: #888;
                    margin-top: 4px;
                }

            .payment-option input[type="radio"] {
                appearance: none;
                position: relative;
                width: 24px;
                height: 24px;
                border: 2px solid #007bff;
                border-radius: 50%;
                cursor: pointer;
                margin: 0;
                outline: none;
            }

            .payment-option label span {
                font-size: 1.1rem;
            }
                .payment-option input[type="radio"]:checked::before {
                    content: "";
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    width: 12px;
                    height: 12px;
                    background-color: #007bff;
                    border-radius: 50%;
                }

        .remove-badge {
            cursor: pointer; /* Thay đổi con trỏ khi hover */
            color: #007bff; /* Màu chữ mặc định */
            border: none; /* Bỏ viền */
            background: none; /* Bỏ nền */
            padding: 0; /* Bỏ padding để nhìn giống như văn bản */
            transition: all 0.3s ease; /* Thêm hiệu ứng chuyển tiếp */
        }

            .remove-badge:hover {
                color: white; /* Thay đổi màu chữ khi hover */
                background-color: red; /* Thay đổi màu nền khi hover */
                border-radius: 5px; /* Bo góc cho nền */
                padding: 5px 10px; /* Thêm padding để làm nổi bật nút */
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); /* Thêm bóng đổ */
            }

        .shipping-method input[type="radio"] {
            appearance: none;
            position: relative;
            width: 24px;
            height: 24px;
            border: 2px solid #007bff;
            border-radius: 50%;
            cursor: pointer;
            margin: 0;
            outline: none;
        }

            .shipping-method input[type="radio"]:checked::before {
                content: "";
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 12px;
                height: 12px;
                background-color: #007bff;
                border-radius: 50%;
            }

        .change-link {
            transition: color 0.3s ease, transform 0.3s ease; /* Hiệu ứng chuyển màu và phóng to */
        }

            .change-link:hover {
                color: #ff4d4f; /* Đổi màu khi hover */
                transform: scale(1.1); /* Phóng to nhẹ khi hover */
            }
    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container">
            <!-- Brand Logo with Image -->
            <a class="navbar-brand d-flex align-items-center" href="#">
                <img src="/images/logo_stmdt.png" alt="TheLiems Logo">
                <span class="fs-3" style="color: blueviolet"> | Thanh Toán</span>
            </a>

            <!-- Freeship Text -->
            <div class="mx-auto">
                <span class="freeship-text">
                    Freeship đơn từ 45k, giảm nhiều hơn cùng
                    <span class="freeship-highlight">FREESHIP XTRA</span>
                </span>
            </div>

            <!-- Contact Button -->
            <div class="contact-button ms-3">
                <i class="bi bi-telephone-fill"></i>
                <div class="contact-number">1900-6035</div>
                <div class="contact-hours">(8h - 21h, cả T7 & CN)</div>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <div class="row">
            <!-- Shipping Method -->
            <div class="col-md-7">
                <div class="card mb-3">
                    <div class="card-header  fs-5">Chọn Phương Thức Giao Hàng</div>
                    <div class="card-body">
                        <!-- Phương thức giao hàng -->
                        <div class="d-flex align-items-center justify-content-between p-2 border rounded mb-3 shipping-method fs-5" style="width: 300px; height: 60px;">
                                <input type="radio" name="shippingMethod" id="shippingMethod1" checked>
                                <label for="shippingMethod1">Giao Tiết Kiệm</label>
                                <span class="badge bg-danger text-white">-30K</span>
                            </div>
                        <div class="d-flex align-items-center justify-content-between p-2 border rounded mb-3 shipping-method fs-5" style="width: 300px; height: 60px;">
                                <input type="radio" name="shippingMethod" id="shippingMethod2">
                                <label for="shippingMethod2">Giao Siêu Tốc</label>
                                <span class="badge bg-danger text-white">30K</span>
                            </div>

                        <div class="mb-3">
                            <div class="d-flex align-items-center mt-1 me-3">
                                <span class="me-2">Giao Tiết Kiệm</span>
                                <span class="text-muted text-decoration-line-through me-2">32.500 ₫</span>
                                <span class="text-danger">8.500 ₫</span>
                            </div>
                        </div>

                        <!-- Thông tin người giao hàng -->
                        <div class="d-flex align-items-center mb-2 border-bottom py-2">
                            <img src="/images/iconship.png" alt="GHTK" width="50" height="30" class="me-2">
                            <span>Được giao từ: GiaoHangTietKiem</span>
                        </div>

                        <!-- Danh sách sản phẩm -->
                        <div class="d-flex align-items-center border-bottom py-2">
                            <img src="/images/sale1.webp" alt="product1" class="img-thumbnail" style="width: 80px; height: 100px;">
                            <div class="ms-3 d-flex flex-column w-100">
                                <p class="fw-bold mb-1">Cà phê hạt Arabica Cầu Đất nguyên chất - 1kg</p>
                                <p class="mb-1">Số lượng: 1</p>
                                <div class="d-flex align-items-center">
                                    <p class="text-muted text-decoration-line-through me-2 mb-0">32.500 ₫</p>
                                    <p class="fw-bold text-danger mb-0">8.500 ₫</p>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center border-bottom py-2">
                            <img src="/images/sale2.webp" alt="product2" class="img-thumbnail" style="width: 80px; height: 100px;">
                            <div class="ms-3 d-flex flex-column w-100">
                                <p class="fw-bold mb-1">Nhà Giả Kim (Tái Bản 2020)</p>
                                <p class="mb-1">Số lượng: 1</p>
                                <div class="d-flex align-items-center">
                                    <p class="text-muted text-decoration-line-through me-2 mb-0">179.000 ₫</p>
                                    <p class="fw-bold text-danger mb-0">113.000 ₫</p>
                                </div>
                            </div>
                        </div>


                        <!-- Mã khuyến mãi -->
                        <div class="d-flex align-items-center mt-3">
                            <img src="/images/icons8-ticket-64.png" alt="promo" width="30" height="30" class="me-2">
                            <span class="text-link">Thêm mã khuyến mãi của Shop</span>
                        </div>
                    </div>
                </div>


                <!-- Payment Method -->
                <div class="payment-card">
                    <div class="payment-card-header">Chọn Hình Thức Thanh Toán</div>
                    <div class="payment-card-body">
                        <div class="payment-option">
                            <input type="radio" name="paymentMethod" id="cashOnDelivery" checked>
                            <label for="cashOnDelivery">
                                <img src="/images/ttmoney.png" alt="cod">
                                <span>Thanh toán tiền mặt khi nhận hàng</span>
                            </label>
                        </div>
                        <div class="payment-option">
                            <input type="radio" name="paymentMethod" id="momoPay">
                            <label for="momoPay">
                                <img src="/images/momo.jpg" alt="momo">
                                <span>Thanh toán bằng ví MoMo</span>
                            </label>
                        </div>
                        <div class="payment-option">
                            <input type="radio" name="paymentMethod" id="zaloPay">
                            <label for="zaloPay">
                                <img src="/images/zlpay.png" alt="zalo">
                                <span>Thanh toán bằng ví ZaloPay</span>
                            </label>
                        </div>
                        <div class="payment-option">
                            <input type="radio" name="paymentMethod" id="vnPay">
                            <label for="vnPay">
                                <img src="/images/vnpay.png" alt="vnpay">
                                <div>
                                    <span>Thanh toán bằng ví VNPAY</span>
                                    <small>Quét Mã QR từ ứng dụng ngân hàng</small>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Section -->
            <div class="col-md-5">
                <div class="card mb-3">
                    <div class="card-header fs-5">Địa Chỉ Giao Hàng <span class="text-link float-end change-link" style="text-decoration: underline;">Thay đổi địa chỉ</span></div>
                    <div class="card-body">
                        <p><strong>Người nhận:</strong> Quý Trường</p>
                        <p><strong>Số điện thoại:</strong> 0337788991</p>
                        <p><strong>Địa chỉ:</strong> Ấp 8B, Xã Vĩnh Lộc, huyện Hồng Dân, Bạc Liêu</p>
                        <p><strong>Loại địa chỉ:</strong> Nhà riêng</p>
                    </div>
                </div>

                <!-- Promotions and Invoice -->
                <div class="card mb-3">
                    <div class="card-header fs-5">Mã Khuyến Mãi</div>
                    <div class="card-body">
                        <div class="promo-item">
                            <img src="/images/iconsale.png" class="rounded me-2" alt="Sale" width="50" height="50">
                            Giảm 4% tới đa 40k
                            <button class="remove-badge ms-auto">Bỏ chọn</button>
                        </div>
                        <div class="promo-item ">
                            <img src="/images/freeship.jpg" class="rounded me-2" alt="Freeship" width="50" height="50">
                             Giảm 8% tới đa 60k
                            <button class="remove-badge ms-auto">Bỏ chọn</button>
                        </div>
                        <hr>
                        <div class="d-flex align-items-center">
                            <img src="/images/icons8-ticket-64.png" alt="promo" width="30" height="30" class="me-2">
                            <span class="text-link">Chọn hoặc nhập mã khác</span>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header fs-5">Yêu Cầu Hóa Đơn</div>
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <input class="form-check-input custom-checkbox" type="checkbox" id="requestInvoice">
                            <label class="form-check-label ms-2" for="requestInvoice">Yêu cầu xuất hóa đơn</label>
                        </div>
                        <p class="text-muted ms-4 mt-1">TheLiems chỉ xuất hóa đơn điện tử</p>
                    </div>
                </div>


                <!-- Order Summary -->
                <div class="card">
                    <div class="card-header fs-5">Đơn Hàng (2 sản phẩm) <span class="text-link float-end change-link" style="text-decoration: underline;">Thay đổi</span></div>
                    <div class="card-body">
                        <div class="summary-item">
                            <span>Tạm tính</span>
                            <span>352.000 ₫</span>
                        </div>
                        <div class="summary-item">
                            <span>Phí vận chuyển</span>
                            <span>32.500 ₫</span>
                        </div>
                        <div class="summary-item summary-item-discount">
                            <span>Khuyến mãi vận chuyển</span>
                            <span>-24.000 ₫</span>
                        </div>
                        <div class="summary-item summary-item-discount">
                            <span>Giảm giá từ khuyến mãi</span>
                            <span>-12.000 ₫</span>
                        </div>
                        <div class="summary-item">
                            <span>Phí vận chuyển</span>
                            <span>0 ₫</span>
                        </div>
                        <hr>
                        <div class="summary-item">
                            <strong class="fs-4">Tổng Tiền</strong>
                            <strong class="fs-4">113.000 ₫</strong>
                        </div>
                        <p class="text-muted">(Đã bao gồm VAT nếu có)</p>
                        <button class="btn btn-danger btn-buy me-2">Thanh Toán (2)</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
