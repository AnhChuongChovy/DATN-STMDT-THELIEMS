@model DATN_STMDT_THELIEMS.Models.Orders

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #EBEAEA;
        }
    </style>
</head>
<body>
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white" style="height: 60px;">
        <div class="ms-5 fs-5">
            <a>Trang chủ ></a>
            <a href="product.html" style="text-decoration: none;color: black;">Tất cả ></a>
            <a>Chi tiết đơn hàng</a>
        </div>
        <div class="d-flex align-items-center me-4">
            <img src="sg-11134201-7rbki-lnthoezew68ce0resize_w450_nl.jpg" height="40px" width="40px" class="rounded-circle me-2" alt="User profile">
            <span>chngchovy</span>
        </div>
    </div>

    <div class="container">
        <div class="bg-white" style="height: auto; width: 100%;">
            <div class="card p-4">
                <div class="mb-4">
                    <h4>@Model.Users.Full_name</h4>
                    <hr>
                </div>

                <!-- Mã đơn hàng -->
                <div class="mb-4">
                    <h6 class="fw-bold"><i class="bi bi-hash"></i> Mã đơn hàng</h6>
                    <p class="fw-bold ms-4">241016Q0DJ4NAU</p>
                </div>

                <!-- Địa chỉ nhận hàng -->
                <div class="mb-4">
                    <h6 class="fw-bold"><i class="bi bi-geo-alt"></i> Địa chỉ nhận hàng</h6>
                    <p class="ms-4">******hậu, N******u, ******07, ******hậu Văn Liêm, Quận Ô Môn, Cần Thơ</p>
                </div>

                <!-- Thông tin vận chuyển -->
                <div class="mb-4">
                    <h6 class="fw-bold"><i class="bi bi-truck"></i> Thông tin vận chuyển</h6>
                    <p class="ms-4">Kiện hàng 1: Nhanh</p>
                    <div class="d-flex align-items-center ms-4">
                        <img src="sg-11134201-7rbki-lnthoezew68ce0resize_w450_nl.jpg" width="50px" height="50px" class="rounded me-3">
                        <p class="mt-2">Ốp lưng thòi trang phong cách</p>
                    </div>
                </div>

                <div class="mb-3">
                    <h6 class="fw-bold"><i class="bi bi-clipboard"></i> Đã huỷ</h6>
                    <p class="ms-4">Ngày huỷ đơn: 26/10/2024</p>
                    <p class="ms-4">Đơn hàng đã bị huỷ bời HieuChu10</p>
                    <p class="ms-4">Lý do huỷ: Tôi không có nhu cầu mua nữa</p>
                </div>
            </div>
        </div>

        <div class="bg-white mt-2 mb-3" style="height: auto; width: 100%;">
            <div class="card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold"><i class="bi bi-clipboard"></i> Thông tin thanh toán</h6>
                </div>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Sản phẩm</th>
                            <th>Đơn Giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = 1;
                        }
                        @if (Model.Order_Details != null && Model.Order_Details.Any())
                        {
                            foreach (var product in Model.Order_Details)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="~/@product.Product_variants.Image" height="50px" width="50px" class="rounded me-3" alt="product image">
                                            <div>
                                                @if (product.Product_variants != null && product.Product_variants.Products != null)
                                                {
                                                    @product.Product_variants.Products.Name
                                                }
                                                <br>Phân loại:
                                                @if (product.Product_variants?.Product_Variant_Options != null)
                                                {
                                                    foreach (var variant in product.Product_variants.Product_Variant_Options)
                                                    {
                                                        @if (variant.variant_values?.Variant_Options != null)
                                                        {
                                                            @variant.variant_values.Name<span>/</span>
                                                        }
                                                    }
                                                    <br /><span>SKU phân loại: @product.Product_variants.Sku</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>@product.Product_price.ToString("N0") ₫</td>
                                    <td>@product.Product_quantity</td>
                                    <td>@product.TotalPrice.ToString("N0") ₫</td>
                                    <td class="@(product.Orders.Status == 0 ? "text-danger" : "text-success") fw-bold">
                                        @(product.Orders.Status == 0 ? "Đã huỷ" : "Đang xử lý")
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">No order details available.</td>
                            </tr>
                        }
                    </tbody>

                </table>

                <div class="mt-3">
                    <div class="row">
                        <div style="width: 80%;">
                            <p class="text-end">Tổng tiền sản phẩm: </p>
                        </div>
                        <div style="width: 20%;">
                            <span style="float: right;">@Model.TotalProductPrice.ToString("N0") ₫</span>
                        </div>
                    </div>

                    <div class="row">
                        <div style="width: 80%;">
                            <p class="text-end">Tổng phí vận chuyển được ước tính: </p>
                        </div>
                        <div style="width: 20%;">
                            <span style="float: right;">0₫</span>
                        </div>
                    </div>

                    <div class="row">
                        <div style="width: 80%;">
                            <p class="text-end">Voucher: </p>
                        </div>
                        <div style="width: 20%;">
                            <span style="float: right;">0₫</span>
                        </div>
                    </div>

                    <div class="row">
                        <div style="width: 80%;">
                            <p class="text-end">Mã giảm giá của shop: </p>
                        </div>
                        <div style="width: 20%;">
                            <span style="float: right;">@Model.Voucher?.Discount_value ₫</span>
                        </div>
                    </div>

                    <div class="row">
                        <div style="width: 80%;">
                            <p class="text-end fw-bold">Tổng tiền thanh toán:</p>
                        </div>
                        <div style="width: 20%;">
                            <span style="float: right;" class="fw-bold text-danger">0₫</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</body>
</html>